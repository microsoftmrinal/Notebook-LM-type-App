# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Cosmos DB Configuration
COSMOS_DB_ENDPOINT=https://your-cosmosdb.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-db-key-here

# Azure AD Configuration (for MSAL authentication)
AZURE_TENANT_ID=your-tenant-id.onmicrosoft.com
AZURE_CLIENT_ID=your-aad-app-client-id
AZURE_APP_ID_URI=api://your-app-id-uri

# Optional: Azure AI Foundry — Claude
# AZURE_CLAUDE_ENDPOINT=https://your-claude-endpoint.eastus2.models.ai.azure.com
# AZURE_CLAUDE_KEY=your-claude-endpoint-key

# Default model: "gpt" or "claude"
DEFAULT_MODEL=gpt

# Optional: Dev mode fallback (not for production)
# SKIP_AUTH=false
